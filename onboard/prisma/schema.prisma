generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  LEADER
  MEMBER
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         Role
  team         Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Cascade)
  teamId       Int?
  ledTeam      Team?     @relation("TeamLeader")
  sessions     Session[]
  progress     OnboardingProgress?
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  leader      User         @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  leaderId    Int          @unique
  members     User[]       @relation("TeamMembers")
  invitations Invitation[]
}

model Invitation {
  id        Int       @id @default(autoincrement())
  email     String
  token     String    @unique
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    Int
  createdAt DateTime
  expiresAt DateTime
  usedAt    DateTime?
}

model OnboardingProgress {
  id     Int     @id @default(autoincrement())
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int     @unique
  step1  Boolean @default(false)
  step2  Boolean @default(false)
  step3  Boolean @default(false)
}

model Session {
  id     Int    @id @default(autoincrement())
  token  String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
}

model Email {
  id      Int      @id @default(autoincrement())
  to      String
  subject String
  body    String
  sentAt  DateTime
}
