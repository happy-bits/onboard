<%- include('header', { title: 'Log in', user: null }) %>

<h2>Log in</h2>

<% if (notice) { %><p class="notice" data-testid="notice"><%= notice %></p><% } %>
<% if (error) { %><p class="error" data-testid="error"><%= error %></p><% } %>

<form method="post" action="/login">
  <p>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="username">
  </p>
  <p>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">
  </p>
  <button type="submit">Log in</button>
</form>

<%- include('footer') %>
