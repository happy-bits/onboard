<%- include('header', { title: 'My team' }) %>

<h2><%= team.name %></h2>

<% if (error) { %><p class="error" data-testid="error"><%= error %></p><% } %>
<% if (notice) { %><p class="notice" data-testid="notice"><%= notice %></p><% } %>

<% if (members.length === 0) { %>
  <p class="muted" data-testid="no-members">No members have joined yet.</p>
<% } else { %>
  <table data-testid="members-table">
    <thead>
      <tr><th>Member</th><th>Progress</th><th>Steps completed</th></tr>
    </thead>
    <tbody>
      <% members.forEach((member) => { %>
        <tr data-testid="member-row" data-email="<%= member.email %>">
          <td><%= member.email %></td>
          <td data-testid="member-progress"><%= member.completed %>/<%= totalSteps %></td>
          <td>
            <ul class="plain">
              <% steps.forEach((step) => { %>
                <li data-testid="member-step"
                    data-step="<%= step.key %>"
                    data-done="<%= memberSteps.get(member.id).has(step.key) %>">
                  <%= memberSteps.get(member.id).has(step.key) ? '✔' : '·' %> <%= step.label %>
                </li>
              <% }) %>
            </ul>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Pending invitations</h2>

<% if (invitations.length === 0) { %>
  <p class="muted" data-testid="no-invitations">No pending invitations.</p>
<% } else { %>
  <ul class="plain" data-testid="invitations">
    <% invitations.forEach((invitation) => { %>
      <li data-testid="invitation-row" data-email="<%= invitation.email %>">
        <%= invitation.email %> <span class="muted">— invited</span>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2>Invite a member</h2>

<form method="post" action="/team/invites" class="inline">
  <div>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required autocomplete="off">
  </div>
  <button type="submit" data-testid="send-invite">Send invitation</button>
</form>

<%- include('footer') %>
