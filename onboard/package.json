{
  "name": "onboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "node scripts/reset-db.js",
    "dump": "node scripts/dump-db.js",
    "build": "node --check src/app.js && node scripts/check-views.js",
    "start": "node src/server.js",
    "pretest": "docker compose up -d --wait",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=e2e --headed"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}
